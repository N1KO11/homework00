#Задание 1
unique_carriers = df.select("OP_UNIQUE_CARRIER").dropDuplicates().count()
print(f"Количество различных перевозчиков: {unique_carriers}")

top_carriers = (
    df.groupBy("OP_UNIQUE_CARRIER")
    .count()
    .orderBy("count", ascending=False)
    .limit(5)
)

top_carriers.show()

#Задание 2
from pyspark.sql.functions import concat_ws

df = df.withColumn("ROUTE", concat_ws("-", df.ORIGIN, df.DEST))

# Считаем частоту направлений и находим топ-10
top_routes_airport = (
    df.groupBy("ROUTE")
    .count()
    .orderBy("count", ascending=False)
    .limit(10)
)

top_routes_airport.show()

df = df.withColumn("CITY_ROUTE", concat_ws("-", df.ORIGIN_CITY_NAME, df.DEST_CITY_NAME))

# Считаем частоту направлений и находим топ-10
top_routes_city = (
    df.groupBy("CITY_ROUTE")
    .count()
    .orderBy("count", ascending=False)
    .limit(10)
)

top_routes_city.show()

# Считаем частоту городов прилета и находим топ-10
top_dest_cities = (
    df.groupBy("DEST_CITY_NAME")
    .count()
    .orderBy("count", ascending=False)
    .limit(10)
)

top_dest_cities.show()

#Задание 3
from pyspark.sql.functions import split, when, col, greatest, sum

# Добавляем столбец "MONTH"
df = df.withColumn("MONTH", split(col("FL_DATE"), "/").getItem(0).cast("int"))

# Считаем количество отмен рейсов по месяцам
cancelled_per_month = (
    df.groupBy("MONTH")
    .agg(sum("CANCELLED").alias("CANCELLED_COUNT"))
    .orderBy("CANCELLED_COUNT", ascending=False)
)

cancelled_per_month.show()

df = df.withColumn(
    "MAIN_REASON",
    when(col("CARRIER_DELAY").isNotNull() & (col("CARRIER_DELAY") == greatest(
        col("CARRIER_DELAY"), col("WEATHER_DELAY"), col("NAS_DELAY"),
        col("SECURITY_DELAY"), col("LATE_AIRCRAFT_DELAY"))), "CARRIER_DELAY")
    .when(col("WEATHER_DELAY").isNotNull() & (col("WEATHER_DELAY") == greatest(
        col("CARRIER_DELAY"), col("WEATHER_DELAY"), col("NAS_DELAY"),
        col("SECURITY_DELAY"), col("LATE_AIRCRAFT_DELAY"))), "WEATHER_DELAY")
    .when(col("NAS_DELAY").isNotNull() & (col("NAS_DELAY") == greatest(
        col("CARRIER_DELAY"), col("WEATHER_DELAY"), col("NAS_DELAY"),
        col("SECURITY_DELAY"), col("LATE_AIRCRAFT_DELAY"))), "NAS_DELAY")
    .when(col("SECURITY_DELAY").isNotNull() & (col("SECURITY_DELAY") == greatest(
        col("CARRIER_DELAY"), col("WEATHER_DELAY"), col("NAS_DELAY"),
        col("SECURITY_DELAY"), col("LATE_AIRCRAFT_DELAY"))), "SECURITY_DELAY")
    .otherwise("LATE_AIRCRAFT_DELAY")
)

# Группируем по месяцу и причине, считая задержки
delays_by_month = (
    df.groupBy("MONTH", "MAIN_REASON")
    .agg(sum("CANCELLED").alias("DELAY_COUNT"))
    .orderBy("MONTH", "DELAY_COUNT", ascending=False)
)

delays_by_month.show()

#Задание 4
from pyspark.ml.feature import StringIndexer, OneHotEncoder
from pyspark.sql.functions import col, month
from pyspark.ml import Pipeline
from pyspark.ml.classification import LogisticRegression

carr_indexer = StringIndexer(inputCol="OP_UNIQUE_CARRIER", outputCol="carrier_index")
carr_encoder = OneHotEncoder(inputCol="carrier_index", outputCol="carrier_fact")

# Кодирование столбца ORIGIN
origin_indexer = StringIndexer(inputCol="ORIGIN", outputCol="origin_index")
origin_encoder = OneHotEncoder(inputCol="origin_index", outputCol="origin_fact")

# Кодирование столбца DEST
dest_indexer = StringIndexer(inputCol="DEST", outputCol="dest_index")
dest_encoder = OneHotEncoder(inputCol="dest_index", outputCol="dest_fact")

df3 = df3.withColumn("label", col("CANCELLED").cast("double"))

from pyspark.ml.feature import VectorAssembler

vec_assembler = VectorAssembler(inputCols=["MONTH", "DISTANCE", "carrier_fact", "dest_fact", "origin_fact"], outputCol="features")

from pyspark.ml import Pipeline

flights_pipe = Pipeline(stages=[dest_indexer, dest_encoder, carr_indexer, carr_encoder, origin_indexer, origin_encoder, vec_assembler])

piped_data = flights_pipe.fit(df3).transform(df3)

training, test = piped_data.randomSplit([.7, .3])

from pyspark.ml.classification import LogisticRegression

lr = LogisticRegression()

import pyspark.ml.evaluation as evals

evaluator = evals.BinaryClassificationEvaluator(metricName="areaUnderROC")

model = lr.fit(training)
print(model)

test_results = model.transform(test)
print(evaluator.evaluate(test_results))

vec_assembler = VectorAssembler(
    inputCols=["MONTH", "DISTANCE", "carrier_fact", "dest_fact"], 
    outputCol="features"
)


